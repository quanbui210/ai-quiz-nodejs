{
  "name": "quiz-backend",
  "version": "1.0.1",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "npm run prisma:generate && tsc",
    "build:skip-prisma": "tsc",
    "start": "nodemon --exec ts-node src/app.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=__tests__",
    "test:integration": "jest --testPathPattern=integration",
    "prisma:generate": "npx prisma generate --schema=./src/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=./src/prisma/schema.prisma",
    "prisma:migrate:deploy": "npx prisma migrate deploy --schema=./src/prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=./src/prisma/schema.prisma",
    "prisma:push:production": "npx prisma db push --schema=./src/prisma/schema.prisma --skip-generate --accept-data-loss",
    "fix:attempts": "ts-node scripts/fix-existing-attempts.ts",
    "seed:plans": "ts-node scripts/seed-default-plans.ts",
    "seed:admin": "ts-node scripts/seed-admin-user.ts",
    "seed:test-users": "ts-node scripts/seed-test-users.ts",
    "sync:usage": "ts-node scripts/sync-user-usage.ts",
    "sync:subscriptions": "ts-node scripts/sync-subscriptions-from-stripe.ts",
    "setup:production": "ts-node scripts/setup-production-db.ts",
    "reset:dev": "ts-node scripts/reset-and-seed-dev.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3001/webhook",
    "scrape:jobs": "ts-node scripts/trigger-job-scraping.ts",
    "process:jobs": "ts-node scripts/trigger-job-processing.ts",
    "analyze:jobs": "ts-node scripts/analyze-existing-jobs.ts",
    "regenerate:trends": "ts-node scripts/regenerate-market-trends.ts",
    "migrate:resource-pricing": "ts-node scripts/migrate-resource-pricing.ts",
    "generate:skill-templates": "ts-node scripts/generate-skill-templates.ts",
    "generate:skill-quizzes": "ts-node scripts/generate-skill-quizzes.ts",
    "migrate:skill-normalization": "ts-node scripts/migrate-skill-normalization.ts"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@langfuse/openai": "^4.4.2",
    "@langfuse/otel": "^4.4.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.80.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.3",
    "apify-client": "^2.8.2",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.2",
    "langfuse": "^3.38.6",
    "mammoth": "^1.7.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.10",
    "openai": "^6.8.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "pgvector": "^0.1.8",
    "prisma": "^6.19.0",
    "stripe": "^19.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "unzipper": "^0.12.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "supabase": "^2.54.11",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
