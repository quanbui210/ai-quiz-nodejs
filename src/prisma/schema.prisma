datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ban status
  isBanned  Boolean   @default(false)
  bannedAt  DateTime?
  banReason String?
  bannedBy  String?   // Admin user ID who banned this user

  // Onboarding & Profile
  hasCompletedOnboarding Boolean   @default(false)
  currentPosition         String?
  targetRole              String?  // User's career goal/target role from onboarding
  currentSkills           String[] // User's current skills for prefilling forms
  onboardingResumeId     String?  // Reference to Resume used during onboarding
  yearsOfExperience       Int?
  industry                String?

  topics            Topic[]
  quizzes           Quiz[]
  answers           Answer[]
  progress          Progress[]
  attempts          QuizAttempt[]
  subscription      UserSubscription?
  usage             UserUsage?
  documents         Document[]
  chatSessions      ChatSession[]
  adminProfile      AdminUser?
  resumes           Resume[]
  interviewSessions InterviewSession[]
  careerGoals       CareerGoal[]
  jobMatches        UserJobMatch[]
  skillMasteryGoals SkillMasteryGoal[]
  skillMasteryQuizzes SkillMasteryQuiz[]
  creditTransactions CreditTransaction[]
}

model Topic {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  quizzes     Quiz[]
  progress    Progress[]
  suggestions Suggestion[]
}

model Quiz {
  id           String       @id @default(uuid())
  title        String
  type         QuizType
  difficulty   Difficulty
  createdAt    DateTime     @default(now())
  expiresAt    DateTime?
  timer        Int? // in seconds
  status       QuizStatus   @default(PENDING)
  count        Int
  topic        Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicId      String?
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId   String?
  careerGoal   CareerGoal?  @relation(fields: [careerGoalId], references: [id], onDelete: SetNull)
  careerGoalId String?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  questions Question[]
  attempts  QuizAttempt[]

  @@index([documentId])
}

model Question {
  id        String       @id @default(uuid())
  text      String
  type      QuestionType
  options   Json? // For MCQ (array of strings)
  correct   String? // Correct answer
  createdAt DateTime     @default(now())

  quiz   Quiz   @relation(fields: [quizId], references: [id])
  quizId String

  explanation Explanation?
  answers     Answer[]
}

model Answer {
  id         String   @id @default(uuid())
  userAnswer String
  isCorrect  Boolean
  createdAt  DateTime @default(now())

  question   Question @relation(fields: [questionId], references: [id])
  questionId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  attempt   QuizAttempt? @relation(fields: [attemptId], references: [id])
  attemptId String?
}

model QuizAttempt {
  id             String        @id @default(uuid())
  status         AttemptStatus @default(IN_PROGRESS)
  score          Float? // Percentage score (0-100), null until completed
  correctCount   Int? // null until completed
  totalQuestions Int // Total questions in the quiz
  elapsedTime    Int? // Time elapsed so far in seconds (for paused attempts)
  timeSpent      Int? // Final time spent in seconds (only set when completed)
  pausedAt       DateTime? // When the attempt was paused
  completedAt    DateTime? // When the attempt was completed (null if in progress/paused)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  quiz   Quiz   @relation(fields: [quizId], references: [id])
  quizId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  answers Answer[]
}

model Explanation {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  question   Question @relation(fields: [questionId], references: [id])
  questionId String   @unique
}

model Progress {
  id         String   @id @default(uuid())
  score      Float    @default(0)
  total      Int      @default(0)
  streak     Int      @default(0)
  lastActive DateTime @default(now())

  topic   Topic  @relation(fields: [topicId], references: [id])
  topicId String

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model Suggestion {
  id             String   @id @default(uuid())
  suggestedTopic String
  reason         String?
  createdAt      DateTime @default(now())

  topic   Topic  @relation(fields: [topicId], references: [id])
  topicId String
}

enum QuizType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  FILL_IN_BLANK
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum QuizStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum AttemptStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
}

model SubscriptionPlan {
  id              String   @id @default(uuid())
  name            String
  stripePriceId   String?  @unique
  stripeProductId String?
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  isCustom        Boolean  @default(false)
  // Limits
  maxTopics                  Int      @default(5)
  maxQuizzes                 Int      @default(10)
  maxDocuments               Int      @default(0)
  maxCareerRoadmaps          Int      @default(1)
  maxInterviewSessionsPerMonth Int    @default(3)
  maxResumes                 Int      @default(2)
  allowedModels              String[] // e.g., ["gpt-3.5-turbo", "gpt-4-turbo"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions UserSubscription[]
}

model UserSubscription {
  id                   String  @id @default(uuid())
  userId               String  @unique
  planId               String
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  maxTopics                  Int      @default(5)
  maxQuizzes                 Int      @default(10)
  maxDocuments               Int      @default(0)
  maxCareerRoadmaps          Int      @default(1)
  maxInterviewSessionsPerMonth Int    @default(3)
  maxResumes                 Int      @default(2)
  
  // NEW: Credit-based system
  creditsPerMonth            Int      @default(50)     // Monthly credit allocation
  currentCredits             Int      @default(50)     // Current available credits
  totalCreditsUsed           Int      @default(0)      // Lifetime credits used
  creditsUsedThisMonth       Int      @default(0)      // Credits used this billing period
  maxRolloverCredits         Int      @default(0)      // Max credits that can rollover (0 for free tier)
  creditPeriodStart          DateTime? // Credit reset period start (monthly, independent of subscription billing)
  creditPeriodEnd            DateTime? // Credit reset period end (monthly, independent of subscription billing)
  
  allowedModels              String[]

  // Subscription status (from Stripe - can be monthly or annual)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime? // Subscription billing period start (from Stripe)
  currentPeriodEnd   DateTime? // Subscription billing period end (from Stripe, can be 1 year for annual)
  cancelAtPeriodEnd  Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model UserUsage {
  id     String @id @default(uuid())
  userId String @unique

  topicsCount              Int @default(0)
  quizzesCount             Int @default(0)
  documentsCount           Int @default(0)
  careerRoadmapsCount      Int @default(0)
  interviewSessionsThisMonth Int @default(0)
  resumesCount             Int @default(0)

  lastResetAt              DateTime @default(now())
  lastMonthReset           DateTime @default(now()) // For monthly resets (interview sessions)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreditTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Int      // Positive for additions, negative for deductions
  balance     Int      // Balance after transaction
  type        CreditTransactionType
  description String?
  metadata    Json?    // Store feature details (e.g., { feature: "career_roadmap", roadmapId: "..." })
  
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

model CreditPricing {
  id          String   @id @default(uuid())
  feature     String   @unique // "quiz_generation", "career_roadmap", "job_matching", etc.
  creditCost  Int      // Cost in credits
  description String?
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([feature, isActive])
}

model AdminUser {
  id          String    @id @default(uuid())
  userId      String    @unique
  role        AdminRole @default(MODERATOR)
  permissions String[]
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id         String         @id @default(uuid())
  userId     String
  filename   String
  filePath   String
  fileSize   Int
  mimeType   String
  status     DocumentStatus @default(UPLOADING)
  vectorized Boolean        @default(false)
  chunkCount Int            @default(0)
  pageCount  Int?           // Number of pages (for PDFs)
  errorMessage String?      // Error message if processing failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  embeddings          DocumentEmbedding[]
  chatSessions        ChatSession[]         // Legacy: single document per session
  sessionDocuments    ChatSessionDocument[] // Many-to-many: multiple documents per session
  quizzes             Quiz[]
  resume              Resume?

  @@index([userId])
  @@index([status])
  @@index([vectorized])
}

model Resume {
  id         String       @id @default(uuid())
  userId     String
  documentId String?      @unique
  title      String?
  filename   String
  filePath   String
  mimeType   String
  status     ResumeStatus @default(PENDING)
  parsedText String?      @db.Text
  pageCount  Int?         // Number of pages (for PDFs)
  analysisScore Float?    // Overall resume quality score (0-100)
  analysisStrengths String[] // What's good about the resume
  analysisWeaknesses String[] // Areas for improvement
  analysisSuggestions Json? // Detailed suggestions and recommendations
  analyzedAt DateTime?   // When analysis was performed
  
  // Job matching fields
  cvEmbedding Unsupported("vector(1536)")? // CV embedding for vector search (generated from parsedText)
  extractedSkills String[] // Skills extracted from CV
  yearsOfExperience Int? // Years of experience extracted from CV
  educationLevel String? // Education level from CV
  
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  document          Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  interviewSessions InterviewSession[]

  @@index([userId])
  @@index([userId, status])
}

model DocumentEmbedding {
  id         String                      @id @default(uuid())
  documentId String
  chunkIndex Int
  chunkText  String                      @db.Text
  embedding  Unsupported("vector(1536)") // OpenAI embedding dimension
  metadata   Json? // Store additional metadata like page number, section, etc.

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chunkIndex])
}

model ChatSession {
  id         String  @id @default(uuid())
  userId     String
  documentId String? // Legacy field for backward compatibility (single document)
  title      String? // Auto-generated or user-provided
  model      String  @default("gpt-4-turbo") // AI model used

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  document            Document?             @relation(fields: [documentId], references: [id], onDelete: SetNull)
  messages            ChatMessage[]
  sessionDocuments    ChatSessionDocument[] // Many-to-many relationship with documents

  @@index([userId])
  @@index([documentId])
}

model ChatSessionDocument {
  id         String   @id @default(uuid())
  sessionId  String
  documentId String
  createdAt  DateTime @default(now())

  session  ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, documentId])
  @@index([sessionId])
  @@index([documentId])
}

model ChatMessage {
  id            String   @id @default(uuid())
  sessionId     String
  role          ChatRole
  content       String   @db.Text
  contextChunks Json? // Store relevant document chunks used for RAG
  tokenCount    Int? // Track token usage

  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  TRIALING
}

enum CreditTransactionType {
  MONTHLY_ALLOCATION   // Monthly credit refresh
  PURCHASE             // User purchased credits
  USAGE                // Used credits for a feature
  REFUND               // Refunded credits (e.g., failed generation)
  ADMIN_ADJUSTMENT     // Admin manually adjusted credits
  ROLLOVER             // Credits rolled over from previous month
  BONUS                // Promotional bonus credits
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ResumeStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model InterviewSession {
  id                String          @id @default(uuid())
  userId            String
  resumeId          String?
  role              String
  roleDescription   String?         @db.Text
  requiredSkills    String[]        // Required skills for the position (alternative to roleDescription)
  level             InterviewLevel
  yearsOfExperience Int?
  country           String?
  industry          String?
  status            InterviewStatus @default(IN_PROGRESS)
  overallScore      Float?
  strengths         String[]
  weaknesses        String[]
  recommendations   Json?
  totalQuestions    Int             @default(0)
  answeredCount     Int             @default(0)
  startedAt         DateTime        @default(now())
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume    Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  questions InterviewQuestion[]
  notes     InterviewNote[]

  @@index([userId])
  @@index([status])
}

model InterviewQuestion {
  id         String           @id @default(uuid())
  sessionId  String
  question   String           @db.Text
  type       QuestionCategory
  order      Int
  aiFeedback Json?
  createdAt  DateTime         @default(now())

  session InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers InterviewAnswer[]

  @@index([sessionId])
  @@index([order])
}

model InterviewAnswer {
  id              String   @id @default(uuid())
  questionId      String
  userAnswer      String   @db.Text
  aiScore         Float?
  improvementTips String?  @db.Text
  exampleAnswer   String?  @db.Text // Example answer provided after user submits, tailored to their response
  starFormatScore Json?
  answeredAt      DateTime @default(now())

  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model InterviewNote {
  id        String   @id @default(uuid())
  sessionId String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum InterviewLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  STAFF
}

enum InterviewStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}

enum QuestionCategory {
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  HR
  CULTURE_FIT
}

model CareerGoal {
  id               String     @id @default(uuid())
  userId           String
  currentRole      String
  targetRole       String
  targetCountryCode String?
  targetLocation   String?
  timeframe        Timeframe
  currentSkills    String[]
  requiredSkills   String[]
  skillGapAnalysis Json?
  roadmapPlan      Json?
  jobMarketInsights Json?
  jobMarketUpdatedAt DateTime?
  progress         Float      @default(0)
  status           GoalStatus @default(ACTIVE)
  startedAt        DateTime   @default(now())
  targetDate       DateTime?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      CareerTask[]
  resources  CareerResource[]
  milestones CareerMilestone[]
  quizzes    Quiz[]
  quizSuggestions CareerQuizSuggestion[]
  skillMasteryGoals SkillMasteryGoal[]

  @@index([userId])
  @@index([status])
}

model CareerQuizSuggestion {
  id                String     @id @default(uuid())
  goalId            String
  skill              String
  suggestedQuizTitle String
  difficulty         Difficulty
  reason             String     @db.Text
  linkedTaskTitle    String?
  linkedTaskId       String?
  phase              Int?        // Phase this suggestion is for
  isActive           Boolean     @default(true) // Mark inactive when quiz is created or suggestion is outdated
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  goal CareerGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([isActive])
  @@index([phase])
  @@unique([goalId, suggestedQuizTitle]) // Prevent duplicate suggestions per goal
}

// Job Matching System - New Architecture

model Job {
  id            String   @id @default(uuid())
  externalId    String?  @unique // External job ID from Indeed/Apify
  title         String
  company       String?
  companyLogoUrl String? // Company logo URL from Indeed/Apify
  location      String?  // e.g., "Helsinki, Finland"
  country       String   @default("fi") // Country code
  descriptionRaw String  @db.Text // Full job description text (raw HTML/text)
  url           String?  // Original job posting URL
  postedDate    DateTime? // When job was posted
  scrapedAt     DateTime @default(now()) // When we scraped it
  salaryMin     Int?
  salaryMax     Int?
  salaryCurrency String?
  jobType       String[] // e.g., ["Full-time", "Part-time"]
  experienceLevel String? // e.g., "Junior", "Mid", "Senior"
  role          String?  // Normalized role (e.g., "Software Engineer", "Data Engineer")
  
  // Processing status
  isProcessed   Boolean  @default(false)
  processedAt   DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  analysis      JobAnalysis?

  @@index([country, location])
  @@index([postedDate])
  @@index([scrapedAt])
  @@index([isProcessed])
  @@index([role])
  @@index([country, role, postedDate])
}

model JobAnalysis {
  id                String   @id @default(uuid())
  jobId             String   @unique
  mustHaveSkills    String[] // Required skills (normalized)
  niceToHaveSkills  String[] // Preferred skills (normalized)
  experienceYears   Int?     // Required years of experience
  educationLevel    String?  // e.g., "Bachelor's", "Master's"
  languageRequirements String[] // e.g., ["Finnish", "English"]
  analysisEmbedding Unsupported("vector(1536)") // OpenAI embedding for vector search
  processedAt       DateTime @default(now())
  
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userMatches UserJobMatch[] // Cached match results

  @@index([jobId])
  // Note: Vector index will be created via SQL migration
}

// Cache user-job match results to avoid recalculating
enum ApplicationStatus {
  VIEWED
  SAVED
  APPLIED
  INTERVIEW
  REJECTED
  OFFERED
  WITHDRAWN
}

model UserJobMatch {
  id                String   @id @default(uuid())
  userId            String
  jobId             String
  matchScore        Int      // 0-100
  skillMatchScore   Int      // Skill match component
  titleMatchScore   Int      // Title/role match component
  vectorSimilarity  Float    // Vector similarity score
  experienceMatch   Boolean
  educationMatch    Boolean
  languageMatch     Boolean
  matchExplanation  Json     // Full explanation object
  userNotes         String?  @db.Text // User's personal notes
  applicationStatus ApplicationStatus? // Current application status
  appliedAt         DateTime? // When user applied
  interviewDate     DateTime? // Scheduled interview date
  outcome           String? // Final outcome (e.g., "accepted", "rejected")
  calculatedAt      DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobAnalysis JobAnalysis @relation(fields: [jobId], references: [jobId], onDelete: Cascade)
  
  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([matchScore])
  @@index([calculatedAt])
  @@index([applicationStatus])
  @@index([userId, applicationStatus])
}

model MarketTrends {
  id                String   @id @default(uuid())
  country           String   @default("fi")
  location           String?  // e.g., "Helsinki" or null for country-wide
  role               String?  // e.g., "Software Engineer" or null for all roles
  periodStart        DateTime // Start of analysis period
  periodEnd          DateTime // End of analysis period
  
  // Aggregated statistics
  totalJobs          Int      @default(0)
  averageExperience  Float?   // Average years of experience required
  topMustHaveSkills  Json     // {skill: count, skill: count} - top 20
  topNiceToHaveSkills Json    // {skill: count, skill: count} - top 20
  salaryStats        Json?    // {min, max, median, average}
  companyStats       Json?    // Top companies hiring
  roleDistribution   Json?    // Distribution of roles
  
  calculatedAt       DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([country, location, role, periodStart], name: "market_trends_unique")
  @@index([country, location])
  @@index([role])
  @@index([calculatedAt])
}

// User CV Embedding for job matching
// We'll add this to Resume model instead of separate table

model CareerTask {
  id             String     @id @default(uuid())
  goalId         String
  phase          Int
  title          String
  description    String?    @db.Text
  taskType       TaskType
  dueDate        DateTime?
  status         TaskStatus @default(PENDING)
  completedAt    DateTime?
  order          Int        @default(0)
  estimatedHours Int?
  dependencies   String[]
  subtopics      Json?      // Detailed list of things to learn/cover (array of strings)
  suggestedProjects Json?  // Suggested practical projects (array of {title, description, difficulty})
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  goal            CareerGoal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  careerResources CareerResource[]

  @@index([goalId])
  @@index([status])
  @@index([phase])
}

model CareerResource {
  id             String       @id @default(uuid())
  goalId         String
  taskId         String?
  title          String
  url            String?
  resourceType   ResourceType
  description    String?      @db.Text
  estimatedHours Int?
  difficulty     Difficulty
  isPaid         Boolean?     // true for paid, false for free
  price          String?      // e.g., "$49.99", "Free", "Subscription-based"
  isCompleted    Boolean      @default(false)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  goal CareerGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  task CareerTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([goalId])
  @@index([taskId])
  @@index([isPaid])
}

model CareerMilestone {
  id          String    @id @default(uuid())
  goalId      String
  title       String
  description String?   @db.Text
  targetDate  DateTime
  achievedAt  DateTime?
  isAchieved  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  goal CareerGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([isAchieved])
}

enum Timeframe {
  THREE_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
  CUSTOM
}

enum GoalStatus {
  GENERATING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum TaskType {
  LEARNING
  PROJECT
  PRACTICE
  INTERVIEW_PREP
  CERTIFICATION
  NETWORKING
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum ResourceType {
  COURSE
  VIDEO
  DOCUMENTATION
  ARTICLE
  BOOK
  TUTORIAL
  PROJECT_TEMPLATE
}

enum SkillMasteryStatus {
  GENERATING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// Normalized Skill reference table
model Skill {
  id          String   @id @default(uuid())
  name        String   @unique // Normalized skill name (e.g., "Docker", "AWS", "React")
  category    String?  // e.g., "Cloud", "Frontend", "Backend"
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  templates   SkillMasteryTemplate[]
  goals       SkillMasteryGoal[]
  quizTemplates SkillMasteryQuizTemplate[]
  
  @@index([name])
  @@index([category])
}

model SkillMasteryTemplate {
  id                  String              @id @default(uuid())
  skillId             String?             // Foreign key to Skill (nullable during migration)
  skillName           String?             // Temporary: will be removed after migration
  skillCategory       String?
  targetLevel         SkillLevel
  includeCertification Boolean            @default(false)
  
  roadmapPlan         Json
  overview            String
  totalWeeks          Int
  
  isActive            Boolean             @default(true)
  version             Int                 @default(1)
  generatedAt         DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  skill               Skill?              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  goals               SkillMasteryGoal[]
  quizTemplates       SkillMasteryQuizTemplate[]
  
  @@unique([skillId, targetLevel, includeCertification])
  @@unique([skillName, targetLevel, includeCertification]) // Temporary unique constraint
  @@index([skillId])
  @@index([skillName]) // Temporary index
  @@index([isActive])
  @@index([skillCategory])
}

model SkillMasteryGoal {
  id              String              @id @default(uuid())
  userId          String
  skillId         String?             // Foreign key to Skill (nullable during migration)
  skillName       String?              // Temporary: will be removed after migration
  skillCategory   String?
  currentLevel    SkillLevel?
  targetLevel     SkillLevel
  status          SkillMasteryStatus  @default(GENERATING)
  progress        Float               @default(0)
  
  roadmapPlan     Json?
  overview        String?
  totalWeeks      Int?
  startedAt       DateTime            @default(now())
  targetDate      DateTime?
  completedAt     DateTime?
  
  careerGoalId    String?
  careerGoal      CareerGoal?         @relation(fields: [careerGoalId], references: [id], onDelete: SetNull)
  
  templateId      String?
  template        SkillMasteryTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  skill           Skill?              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks           SkillMasteryTask[]
  resources       SkillMasteryResource[]
  milestones      SkillMasteryMilestone[]
  concepts        SkillConcept[]
  quizzes         SkillMasteryQuiz[]
  
  @@index([userId])
  @@index([skillId])
  @@index([skillName]) // Temporary index
  @@index([status])
  @@index([careerGoalId])
  @@index([templateId])
  @@index([userId, status])
}

model SkillMasteryTask {
  id              String              @id @default(uuid())
  goalId          String
  phase           Int
  title           String
  description     String?
  taskType        TaskType
  estimatedHours  Int?
  order           Int
  status          TaskStatus          @default(PENDING)
  dueDate         DateTime?
  completedAt     DateTime?
  
  subtopics       Json?
  suggestedProjects Json?
  theory          Json?
  examples        Json?
  concepts        Json?
  
  goal            SkillMasteryGoal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  resources       SkillMasteryResource[]
  
  @@index([goalId])
  @@index([goalId, phase])
  @@index([goalId, status])
  @@index([goalId, phase, status])
  @@index([status])
}

model SkillMasteryResource {
  id              String              @id @default(uuid())
  goalId          String
  taskId          String?
  title           String
  url             String?
  description     String?
  resourceType    ResourceType
  estimatedHours  Int?
  difficulty      Difficulty
  isPaid          Boolean?
  price           String?
  
  source          String?
  lastVerified    DateTime?
  isUpToDate      Boolean?
  
  goal            SkillMasteryGoal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  task            SkillMasteryTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  
  @@index([goalId])
  @@index([goalId, taskId])
  @@index([taskId])
}

model SkillMasteryMilestone {
  id              String              @id @default(uuid())
  goalId          String
  title           String
  description     String?
  targetDate      DateTime
  completedAt     DateTime?
  
  goal            SkillMasteryGoal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  
  @@index([goalId])
}

model SkillConcept {
  id              String              @id @default(uuid())
  goalId          String
  title           String
  content         String
  examples        Json?
  relatedConcepts String[]
  difficulty      Difficulty
  order           Int
  
  goal            SkillMasteryGoal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  
  @@index([goalId])
}

model SkillMasteryQuizTemplate {
  id              String              @id @default(uuid())
  skillId         String?             // Foreign key to Skill (nullable during migration)
  skillName       String?             // Temporary: will be removed after migration
  templateId      String?             // Foreign key to SkillMasteryTemplate (links quiz to roadmap)
  phase           Int
  title           String
  description     String?
  difficulty      Difficulty          @default(INTERMEDIATE)
  
  questions       SkillMasteryQuizQuestion[]
  userQuizzes     SkillMasteryQuiz[]
  
  isActive        Boolean             @default(true)
  version         Int                 @default(1)
  generatedAt     DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  skill           Skill?              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  template        SkillMasteryTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  @@unique([skillId, phase])
  @@unique([skillName, phase]) // Temporary unique constraint
  @@unique([templateId, phase])
  @@index([skillId])
  @@index([skillName]) // Temporary index
  @@index([templateId])
  @@index([isActive])
}

model SkillMasteryQuizQuestion {
  id              String              @id @default(uuid())
  templateId      String
  question        String
  type            QuestionType
  options         Json?               // For multiple choice: ["Option A", "Option B", ...]
  correctAnswer   String              // Answer or option index
  explanation     String?             // Why this answer is correct
  points          Int                 @default(10)
  order           Int
  
  template        SkillMasteryQuizTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  @@index([templateId])
}

model SkillMasteryQuiz {
  id              String              @id @default(uuid())
  userId          String
  goalId          String
  templateId      String
  
  title           String
  phase           Int
  status          QuizStatus          @default(PENDING)
  score           Float?
  totalQuestions  Int
  correctAnswers  Int?
  
  startedAt       DateTime?
  completedAt     DateTime?
  
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal            SkillMasteryGoal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  template        SkillMasteryQuizTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  attempts        SkillMasteryQuizAttempt[]
  
  @@index([userId])
  @@index([goalId])
  @@index([goalId, phase])
  @@index([goalId, status])
  @@index([templateId])
  @@index([status])
}

model SkillMasteryQuizAttempt {
  id              String              @id @default(uuid())
  quizId          String
  answers         Json                // { questionId: answer }
  score           Float
  correctCount    Int
  totalQuestions  Int
  completedAt     DateTime            @default(now())
  
  quiz            SkillMasteryQuiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  @@index([quizId])
}
